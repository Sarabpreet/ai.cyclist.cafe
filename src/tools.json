  {
    "name": "prepare_table_reservation",
    "group": "reservations",
    "scope": "reservations:write",
    "effect": "Private review link · customer approval creates a pending request",
    "example": {
      "startAt": "2030-01-02T18:00:00+05:30",
      "partySize": 2,
      "notes": "A quiet corner, if possible.",
      "requestId": "5a0f5b90-9f73-4ae5-95f2-d590a50e5791"
    },
    "description": "Prepare a table request for the connected Cyclist account using an explicit timezone date/time, party size and optional notes. Reuse requestId on retry. Send the returned trusted review URL to the customer; do not open or approve it yourself. Only customer approval creates the shared pending reservation in POS and People. A table is reserved only when café staff confirm it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "Explicit date/time with timezone; the café uses Asia/Kolkata (India)."
        },
        "partySize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "startAt",
        "partySize",
        "requestId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "readOnly": false
  },
  {
    "name": "prepare_reservation_cancellation",
    "group": "reservations",
    "scope": "reservations:write",
    "effect": "Private review link · customer approval cancels the booking",
    "example": {
      "reservationId": "RESERVATION_ID_FROM_MY_RESERVATIONS",
      "requestId": "20cf751e-ad37-4f10-b643-ffb7044d2d2e"
    },
    "description": "Prepare cancellation of your own upcoming pending or confirmed reservation using its canonical reservationId. The customer must approve cancellation on the trusted Cyclist page. Preparing or opening the link does not cancel the booking.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "reservationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "reservationId",
        "requestId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "readOnly": false
  },
