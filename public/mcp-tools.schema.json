    {
      "name": "get_cafe_status",
      "title": "Café status",
      "description": "Use this to check Cyclist Café opening hours, local timezone and whether dine-in or takeaway is currently available. Use authenticated checkout tools for customer-confirmed orders when enabled.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
