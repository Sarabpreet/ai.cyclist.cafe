          {
            "type": "noauth"
          }
        ]
      }
    },
    {
      "name": "prepare_event_rsvp",
      "title": "Prepare an RSVP",
      "description": "Prepare a customer confirmation link for going, interested or cancellation. Requires a registered People profile. No seat is reserved until the customer approves on the Cyclist page. Supply a new UUID requestId for each intended change; retry with the same UUID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          },
          "response": {
            "type": "string",
            "enum": [
              "going",
              "interested",
              "cancelled"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "eventId",
          "response",
          "requestId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "events:rsvp"
            ]
          }
        ]
      }
    },
    {
      "name": "get_event_rsvp_status",
