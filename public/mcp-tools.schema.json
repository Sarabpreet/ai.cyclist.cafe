        "securitySchemes": [
          {
            "type": "noauth"
          }
        ]
      }
    },
    {
      "name": "search_menu",
      "title": "Search the café menu",
      "description": "Primary tool for menu browsing and prices. One call returns matching products/combos, live availability, categories and café status. Default summaries are compact; use detail=full when modifier choices or full descriptions are requested, instead of fetching every result separately. Use a focused query/category and limit 5–10 for recommendations; omit query for a menu overview. Use availableOnly for currently orderable items. Base prices exclude checkout adjustments; dietary tags do not guarantee allergen safety.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100
          },
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "fulfilment": {
            "description": "Use takeaway to check item-specific takeaway restrictions.",
            "type": "string",
            "enum": [
              "dine-in",
              "takeaway"
            ]
          },
          "availableOnly": {
            "type": "boolean"
          },
          "vegetarian": {
            "type": "boolean"
          },
          "includeCombos": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "detail": {
            "default": "summary",
            "description": "Summary returns names, prices, availability and hasOptions. Full also returns complete descriptions and modifier choices for all matching items in this page.",
            "type": "string",
            "enum": [
              "summary",
              "full"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "noauth"
          }
        ]
      }
    },
    {
      "name": "get_menu_item",
      "title": "Menu item details",
      "description": "Read full details for one selected item when its description or modifier choices are needed. Supply the ID and kind from search_menu. Search summaries already contain prices, availability and takeaway eligibility; do not call this for every search result just to repeat those fields. Never invent options or prices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          },
          "kind": {
            "default": "product",
            "type": "string",
            "enum": [
              "product",
              "combo"
            ]
          },
          "fulfilment": {
            "description": "Use takeaway to check item-specific takeaway restrictions.",
            "type": "string",
            "enum": [
              "dine-in",
              "takeaway"
            ]
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "noauth"
          }
        ]
      }
    },
    {
      "name": "quote_order",
      "title": "Quote a takeaway order",
      "description": "Calculate an expiring INR bill using exact menu IDs, quantities, options and an optional saved coupon. Creates a private quote only: no order, stock reservation or payment. Required single-choice options must be selected explicitly. Takeaway only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fulfilment": {
            "type": "string",
            "const": "takeaway"
          },
          "items": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,160}$"
                },
                "kind": {
                  "default": "product",
                  "type": "string",
                  "enum": [
                    "product",
                    "combo"
                  ]
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "options": {
                  "default": [],
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "groupName": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "optionName": {
                        "type": "string",
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "groupName",
                      "optionName"
                    ],
                    "additionalProperties": false
                  }
                },
                "notes": {
                  "default": "",
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "id",
                "quantity"
              ],
              "additionalProperties": false
            }
          },
          "couponCode": {
            "type": "string",
            "maxLength": 50
          },
          "notes": {
            "default": "",
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "fulfilment",
          "items"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "orders:quote"
            ]
          }
        ]
      }
    },
    {
      "name": "prepare_checkout",
      "title": "Prepare customer checkout",
      "description": "Prepare a unique ten-minute Cyclist ticket link for an owned quote and send it to the customer in chat. No sign-in is needed on the link. The customer must explicitly confirm or can cancel and start again. Confirmation creates one unpaid ticket visible in POS and Kitchen Active as Not paid. Payment at the café counter is required before Kitchen can accept or prepare it; Kitchen acceptance then confirms processing. This tool cannot place or pay for the order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          }
        },
        "required": [
          "quoteId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "orders:checkout"
            ]
          }
        ]
      }
    },
    {
      "name": "get_checkout_status",
      "title": "Check customer checkout",
      "description": "Read this connection’s ticket status: awaiting_confirmation, submitted, cancelled or expired, with the owned order when present. Submitted means a ticket exists, not payment or Kitchen acceptance. Unpaid tickets are visible in Active but cannot be prepared. Cancelled tickets require a fresh quote/link. Does not create orders, cancel them or reconcile payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "checkoutId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          }
        },
        "required": [
          "checkoutId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "orders:read"
            ]
          }
        ]
      }
    },
    {
      "name": "list_my_orders",
      "title": "My recent orders",
      "description": "Discover your own orders from the last seven days, newest first. Defaults to 5; limit 1 for my latest order, maximum 20. Follow opaque nextCursor for more. Use the returned canonical orderId with get_my_order for details. Requires explicit orders:read consent; no customer selectors.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "cursor": {
            "type": "string",
            "minLength": 40,
            "maxLength": 2048
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "orders:read"
            ]
          }
        ]
      }
    },
    {
      "name": "get_my_order",
      "title": "Track my recent order",
      "description": "Read your own order from the last seven days. Supply exactly one: canonical orderId from list_my_orders/submitted checkout, or explicit display orderNumber. Never infer internal IDs from display numbers. No match never reveals another customer’s order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          },
          "orderNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
