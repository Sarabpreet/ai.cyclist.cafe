{
  "source": "Actual local MCP SDK tools/list; use live tools/list for deployed configuration and current limits.",
  "apiVersion": "1.2.0",
  "referenceSearchLimit": 20,
  "deploymentStatus": "Server 1.2.0 and all 15 tools verified in hosted discovery on 2026-11-04. Customer flow tests use isolated fixtures; this is not a production SMS/order end-to-end verification.",
  "checkoutPolicy": {
    "linkTtlMinutes": 10,
    "requiresSignIn": false,
    "customerConfirmationRequired": true,
    "payment": "cafe-counter",
    "visibleInKitchenBeforePayment": true,
    "preparationRequiresPayment": true,
    "cancellation": "unconfirmed-or-unpaid-waiting-ticket",
    "restart": "new-quote-required"
  },
  "tools": [
