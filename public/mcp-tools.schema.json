            "scopes": [
              "orders:read"
            ]
          }
        ]
      }
    },
    {
      "name": "get_my_rewards",
      "title": "My reward points",
      "description": "Read the connected customer’s current reward-point balance and published earning/redemption rules. Requires explicit rewards:read consent. Does not redeem points or disclose the customer profile or ledger.",
      "inputSchema": {
